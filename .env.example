# Explicit loading: webaudit --env-file .env <command>
# === AI Models (Required - Choose at least one) ===

# Google AI Studio (Gemini)
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Generic OpenAI (OpenAI, OpenRouter, DeepSeek, Local, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# === Optional Configuration ===
# HEADLESS=true # Set to false to see the browser

# === LangSmith Observability (Optional) ===
# See docs/observability.md — set TRACING=true with a valid API key to enable
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=web-audit-agent


